.outer
  .container
    %h2= t('sign_in')
    - demo = Hours.demo_mode?
    - if demo
      .demo-credentials= t("demo.sign_in_hint", email: DemoAccount::EMAIL, password: DemoAccount::PASSWORD)
    = simple_form_for(resource, :as => resource_name, :url => session_path(resource_name)) do |f|
      .form-inputs
        = f.input :email, :required => false, :autofocus => true, :input_html => (demo ? { value: DemoAccount::EMAIL } : {})
        = f.input :password, :required => false, :input_html => (demo ? { value: DemoAccount::PASSWORD } : {})
        = f.input :remember_me, :as => :boolean if devise_mapping.rememberable?
      .form-actions
        = f.button :submit, t("sign_in"), data: { disable_with: t("loader.signing_in") }
    = render "devise/shared/links"
