%div.marked_entries
  %p#amount_marked_entries
    =t("billables.select_marked")
  %button{id: "submit-billable-entries", disabled: true}
    =t("billables.buttons.bill_selected")
.billables
  .outer
    %h1= t("billables.billable_entries")
    - summaries = unbilled_by_client(@projects, @hours_by_project, @mileages_by_project)
    - if summaries.any?
      .container.invoice-summary
        %h3= t("invoices.unbilled_by_client")
        %table.invoice-table
          - summaries.each do |row|
            %tr
              %td= row[:client].name
              %td.amount= "#{row[:hours]} h"
              %td.amount
                - if row[:amount_cents]
                  = money(row[:amount_cents], row[:client].currency)
                - else
                  %span.muted= t("invoices.no_rate")
              %td.amount= link_to t("invoices.create_for"), new_invoice_path(client_id: row[:client].id), class: "button"
    = form_tag("/billables", method: "post", remote: true, id: "billable-entries-form", autocomplete: "off") do
      - @projects.each do |project|
        .container
          %h1= project.name
          - if (hours = @hours_by_project[project.id])
            = render "hours_entries", project: project, hours: hours
          - if (mileages = @mileages_by_project[project.id])
            = render "mileages_entries", project: project, mileages: mileages
      %button#submit-billable-entries-test= t("billables.buttons.bill_selected")
