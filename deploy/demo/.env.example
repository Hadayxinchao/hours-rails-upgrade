# Copy to deploy/demo/.env (git-ignored) and fill in.
# Generate secrets with:  openssl rand -hex 64   /   openssl rand -hex 24
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
TUNNEL_TOKEN=

# The demo account lives at <DEMO_SUBDOMAIN>.<your domain>.
DEMO_SUBDOMAIN=hoursdemo
DEMO_HOST=hoursdemo.hadayxinchao.com
